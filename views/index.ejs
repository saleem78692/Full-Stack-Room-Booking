<%- include('include/header.ejs') %>
    <!-- Hero  -->

    <section id="hero" class="py-5">

        <div class="overlay"></div>

        <div class="container h-100">

            <div class="row h-100 align-items-center">

                <div class="col-lg-6 col-md-8">

                    <div class="hero-content">

                        <span class="hero-tag">
                            PREMIUM PAYING GUEST FACILITY
                        </span>

                        <h1 class="display-3 fw-bold mt-3">
                            Bhadauriya <br> Enterprises
                        </h1>

                        <p class="lead my-4">
                            Experience premium PG accommodation with fully furnished
                            rooms, bed almirah, high-speed Wi-Fi, CCTV security, laundry facility,
                            power backup.
                        </p>

                        <div class="d-flex gap-3 flex-wrap">

                            <button type="submit" data-bs-toggle="modal" data-bs-target="#booking"
                                class="btn btn-book py-3 px-4 rounded-pill">
                                Book Now
                            </button>

                            <a href="#contact" class="btn btn-outline-light px-4 py-3 rounded-pill">
                                Contact Us
                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="container-fluid">

            <div class="floating-contact">

                <!-- Call -->

                <a href="tel:<%= settings.phone %>" class="call-btn">

                    <i class="bi bi-telephone-fill"></i>

                </a>

                <!-- WhatsApp -->

                <a href="https://wa.me/<%= settings.phone %>?text=Hello%20Bhadhauriya%20Enterprises!%20%F0%9F%91%8B%0A%0AI%20want%20to%20book%20a%20room.%20Please%20share%20the%20details.%0A%0A%E2%9C%85%20Room%20Availability%0A%E2%9C%85%20Rent%20Details%0A%E2%9C%85%20Facilities%0A%E2%9C%85%20Location%0A%0AThank%20You!"
                    target="_blank" class="whatsapp-btn">

                    <i class="bi bi-whatsapp"></i>

                </a>

            </div>
        </div>

    </section>

    <!-- About  -->

    <section id="about" class="py-5">

        <div class="container">

            <div class="row align-items-center gy-5 about-div">

                <!-- Images -->
                <div class="col-lg-6 ">

                    <div class="about-images position-relative ">

                        <img src="https://images.unsplash.com/photo-1560448204-e02f11c3d0e2?q=80&w=700&auto=format&fit=crop"
                            class="img1 shadow" alt="">

                        <img src="https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?q=80&w=700&auto=format&fit=crop"
                            class="img2 shadow" alt="">

                        <img src="https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?q=80&w=700&auto=format&fit=crop"
                            class="img3 shadow" alt="">

                    </div>

                </div>

                <!-- Content -->
                <div class="col-lg-6">

                    <span class="about-title">
                        ABOUT US
                    </span>

                    <h2 class="fw-bold mt-3">
                        Comfortable Living at
                        <span>Bhadauriya Enterprises
                        </span>
                    </h2>

                    <p class="text-muted mt-3">
                        Bhadauriya Enterprises
                        provides premium PG accommodation for students
                        and working professionals with modern amenities,
                        a safe environment, and affordable pricing.
                    </p>

                    <div class="row mt-4">

                        <div class="col-md-6 mb-3">

                            <div class="feature-box">

                                <i class="bi bi-house-door-fill"></i>

                                <div>
                                    <h6>Luxury Rooms</h6>
                                    <small>Fully Furnished Rooms</small>
                                </div>

                            </div>

                        </div>

                        <div class="col-md-6 mb-3">

                            <div class="feature-box">

                                <i class="bi bi-wifi"></i>

                                <div>
                                    <h6>Free Wi-Fi</h6>
                                    <small>High Speed Internet</small>
                                </div>

                            </div>

                        </div>

                        <div class="col-md-6 mb-3">

                            <div class="feature-box">

                                <i class="bi bi-shield-check"></i>

                                <div>
                                    <h6>24×7 Security</h6>
                                    <small>CCTV Monitoring</small>
                                </div>

                            </div>

                        </div>

                        <div class="col-md-6 mb-3">

                            <div class="feature-box">

                                <i class="bi bi-lightning-charge-fill"></i>

                                <div>
                                    <h6>Power Backup</h6>
                                    <small>24 Hours Electricity</small>
                                </div>

                            </div>

                        </div>

                    </div>

                    <a href="#service" class="btn btn-about mt-3 px-4 py-3 rounded-pill">
                        Explore More
                    </a>

                </div>

            </div>

        </div>

    </section>

    <!-- Service  -->

    <section id="service" class="py-5">

        <div class="container">

            <!-- Heading -->

            <div class="text-center mb-5">

                <span class="section-title">
                    OUR ROOMS
                </span>

                <h2 class="fw-bold mt-3">
                    Choose Your Perfect Room
                </h2>

                <p class="text-muted">
                    Comfortable & Affordable Rooms with Modern Facilities
                </p>

            </div>

            <!-- Filter Buttons -->

            <div class="text-center mb-5">

                <button class="btn room-filter active" data-filter="all">
                    All Rooms
                </button>

                <button class="btn room-filter" data-filter="single">
                    Single Sharing
                </button>

                <button class="btn room-filter" data-filter="double">
                    Double Sharing
                </button>

                <button class="btn room-filter" data-filter="triple">
                    Triple Sharing
                </button>

            </div>

            <div class="row g-4">

                <div class="row g-4" id="rooms-container">
                    <% if (rooms && rooms.length> 0) { %>
                        <% rooms.forEach(room=> { %>
                            <div class="col-lg-4 col-md-6 room-item" data-filter="<%= room.roomtype.toLowerCase() %>">
                                <div class="room-card">
                                    <div class="room-image">
                                        <% if (room.image) { %>
                                            <img src="<%= room.image.startsWith('http') || room.image.startsWith('/') ? room.image : '/uploads/' + room.image %>" class="img-fluid"
                                                alt="Room <%= room.roomnumber %>" onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1616047006789-b7af5afb8c20?q=80&w=880&auto=format&fit=crop';">
                                            <% } else { %>
                                                <img src="https://images.unsplash.com/photo-1616047006789-b7af5afb8c20?q=80&w=880&auto=format&fit=crop"
                                                    class="img-fluid" alt="No Image">
                                                <% } %>

                                                    <span
                                                        class="room-status <%= room.roomstatus === 'Available' ? 'available' : 'booked' %>">
                                                        <%= room.roomstatus %>
                                                    </span>
                                    </div>

                                    <div class="p-4">
                                        <h4>
                                            <%= room.roomtype %> Room - <%= room.roomnumber %>
                                        </h4>

                                        <h5 class="price">
                                            ₹<%= room.roomrupees %> <small>/ Monthly</small>
                                        </h5>

                                        <div class="room-feature">
                                            <% if (room.roomdesc) { %>
                                                <% room.roomdesc.split(',').forEach(feature=> { %>
                                                    <span><i class="bi bi-check-circle"></i>
                                                        <%= feature.trim() %>
                                                    </span>
                                                    <% }) %>
                                                        <% } else { %>
                                                            <span><i class="bi bi-wifi"></i> WiFi</span>
                                                            <span><i class="bi bi-tv"></i> TV</span>
                                                            <% } %>
                                        </div>

                                        <div class="d-flex gap-2 mt-4">
                                            <button type="button" data-bs-toggle="modal" data-bs-target="#booking"
                                                class="btn btn-book w-50" data-room="<%= room.roomnumber %>"
                                                data-price="<%= room.roomrupees %>">
                                                Book Now
                                            </button>

                                            <a href="/room/<%= room._id %>" class="btn btn-detail w-50"
                                                title="View Details">
                                                View Details
                                            </a>

                                        </div>
                                    </div>
                                </div>
                            </div>
                            <% }) %>
                                <% } else { %>
                                    <div class="col-12 text-center py-5">
                                        <h4 class="text-muted">No rooms available at the moment</h4>
                                    </div>
                                    <% } %>
                </div>


            </div>

        </div>

    </section>

    <!-- Gallary  -->

    <section id="gallary" class="">

        <div class="container">

            <!-- Heading -->

            <div class="text-center mb-5">

                <span class="gallery-title">
                    ROOM GALLERY
                </span>

                <h2 class="fw-bold mt-3">
                    Explore Our Premium Rooms
                </h2>

                <p class="text-muted">
                    Modern, Comfortable & Affordable Living Spaces
                </p>

            </div>

            <!-- Slider -->

            <div class="swiper gallerySwiper">

                <div class="swiper-wrapper">
                    <% if (typeof gallery !== 'undefined' && gallery && gallery.length > 0) { %>
                        <% gallery.forEach(item => { 
                            const imgSrc = (item.image && (item.image.startsWith('http') || item.image.startsWith('/'))) ? item.image : '/uploads/' + item.image;
                        %>
                            <div class="swiper-slide">
                                <div class="gallery-card">
                                    <div class="gallery-img">
                                        <img src="<%= imgSrc %>" class="img-fluid" alt="<%= item.title %>" onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1583847268964-b28dc8f51f92?q=80&w=687&auto=format&fit=crop';">
                                        <div class="gallery-overlay">
                                            <a href="<%= imgSrc %>"
                                                class="glightbox btn btn-light rounded-circle" data-type="image"
                                                data-gallery="room-gallery">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </div>
                                    </div>
                                    <div class="p-4">
                                        <h5><%= item.title %></h5>
                                        <p class="text-muted mb-0">
                                            <%= item.subtitle || '' %>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <!-- Default Initial Gallery items -->
                        <div class="swiper-slide">
                            <div class="gallery-card">
                                <div class="gallery-img">
                                    <img src="https://images.unsplash.com/photo-1583847268964-b28dc8f51f92?q=80&w=687&auto=format&fit=crop" class="img-fluid" alt="Luxury Single Room">
                                    <div class="gallery-overlay">
                                        <a href="https://images.unsplash.com/photo-1583847268964-b28dc8f51f92?q=80&w=687&auto=format&fit=crop"
                                            class="glightbox btn btn-light rounded-circle" data-type="image"
                                            data-gallery="room-gallery">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </div>
                                </div>
                                <div class="p-4">
                                    <h5>Luxury Single Room</h5>
                                    <p class="text-muted mb-0">Fully Furnished with AC & Wi-Fi</p>
                                </div>
                            </div>
                        </div>

                        <div class="swiper-slide">
                            <div class="gallery-card">
                                <div class="gallery-img">
                                    <img src="https://images.unsplash.com/photo-1564078516393-cf04bd966897?w=600&auto=format&fit=crop" class="img-fluid" alt="Premium Double Room">
                                    <div class="gallery-overlay">
                                        <a href="https://images.unsplash.com/photo-1564078516393-cf04bd966897?w=600&auto=format&fit=crop"
                                            class="glightbox btn btn-light rounded-circle" data-type="image"
                                            data-gallery="room-gallery">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </div>
                                </div>
                                <div class="p-4">
                                    <h5>Premium Double Room</h5>
                                    <p class="text-muted mb-0">Spacious & Comfortable</p>
                                </div>
                            </div>
                        </div>

                        <div class="swiper-slide">
                            <div class="gallery-card">
                                <div class="gallery-img">
                                    <img src="https://images.unsplash.com/photo-1589834390005-5d4fb9bf3d32?w=600&auto=format&fit=crop" class="img-fluid" alt="Triple Sharing Room">
                                    <div class="gallery-overlay">
                                        <a href="https://images.unsplash.com/photo-1589834390005-5d4fb9bf3d32?w=600&auto=format&fit=crop"
                                            class="glightbox btn btn-light rounded-circle" data-type="image"
                                            data-gallery="room-gallery">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </div>
                                </div>
                                <div class="p-4">
                                    <h5>Triple Sharing Room</h5>
                                    <p class="text-muted mb-0">Affordable & Modern</p>
                                </div>
                            </div>
                        </div>

                        <div class="swiper-slide">
                            <div class="gallery-card">
                                <div class="gallery-img">
                                    <img src="https://images.unsplash.com/photo-1531835551805-16d864c8d311?w=600&auto=format&fit=crop" class="img-fluid" alt="Luxury Interior">
                                    <div class="gallery-overlay">
                                        <a href="https://images.unsplash.com/photo-1531835551805-16d864c8d311?w=600&auto=format&fit=crop"
                                            class="glightbox btn btn-light rounded-circle" data-type="image"
                                            data-gallery="room-gallery">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </div>
                                </div>
                                <div class="p-4">
                                    <h5>Luxury Interior</h5>
                                    <p class="text-muted mb-0">Elegant Furniture Design</p>
                                </div>
                            </div>
                        </div>

                        <div class="swiper-slide">
                            <div class="gallery-card">
                                <div class="gallery-img">
                                    <img src="https://images.unsplash.com/photo-1556020685-ae41abfc9365?w=600&auto=format&fit=crop" class="img-fluid" alt="Premium Living Area">
                                    <div class="gallery-overlay">
                                        <a href="https://images.unsplash.com/photo-1556020685-ae41abfc9365?w=600&auto=format&fit=crop"
                                            class="glightbox btn btn-light rounded-circle" data-type="image"
                                            data-gallery="room-gallery">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </div>
                                </div>
                                <div class="p-4">
                                    <h5>Premium Living Area</h5>
                                    <p class="text-muted mb-0">Comfortable & Peaceful</p>
                                </div>
                            </div>
                        </div>

                        <div class="swiper-slide">
                            <div class="gallery-card">
                                <div class="gallery-img">
                                    <img src="https://images.unsplash.com/photo-1536494126589-29fadf0d7e3c?w=600&auto=format&fit=crop" class="img-fluid" alt="Modern Bedroom">
                                    <div class="gallery-overlay">
                                        <a href="https://images.unsplash.com/photo-1536494126589-29fadf0d7e3c?w=600&auto=format&fit=crop"
                                            class="glightbox btn btn-light rounded-circle" data-type="image"
                                            data-gallery="room-gallery">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </div>
                                </div>
                                <div class="p-4">
                                    <h5>Modern Bedroom</h5>
                                    <p class="text-muted mb-0">Luxury Lifestyle Experience</p>
                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>

                <!-- Navigation -->

                <div class="swiper-button-next"></div>

                <div class="swiper-button-prev"></div>

                <div class="swiper-pagination mt-4"></div>

            </div>

        </div>

    </section>


    <!-- Testomonial  -->

    <section id="Testomonial" class="py-5 testimonial-section">
        <div class="container"> <!-- Section Header -->
            <div class="text-center mb-5"> <span class="gallery-title">TESTIMONIAL</span>
                <h2 class="fw-bold mt-3"> What Our Students Say </h2>
                <p class="text-muted"> See Why Students Love Living With Us </p>
            </div> <!-- Slider -->
            <div class="testimonial-slider">
                <div class="testimonial-track" id="testimonialTrack">
                    <% review.forEach(item=> { %> <div class="testimonial-slide">
                            <div class="card testimonial-card h-100 border-0">
                                <div class="card-body p-4 d-flex flex-column"> <!-- Stars -->
                                    <div class="text-warning mb-3">
                                        <% for (let i=1; i <=5; i++) { %>
                                            <% if (i <=Number(item.rating)) { %> <i class="bi bi-star-fill"></i>
                                                <% } else { %> <i class="bi bi-star"></i>
                                                    <% } %>
                                                        <% } %> <span class="text-dark small ms-2">
                                                                <%= item.rating %>/5
                                                            </span>
                                    </div> <!-- Quote Icon -->
                                    <div class="quote-icon mb-3"> <i class="bi bi-quote"></i> </div>
                                    <!-- Review Message -->
                                    <p class="testimonial-message flex-grow-1">
                                        <%= item.message %>
                                    </p>
                                    <hr> <!-- Reviewer -->
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="reviewer-avatar"> <i class="bi bi-person-fill"></i> </div>
                                        <div>
                                            <h6 class="fw-bold mb-1">
                                                <%= item.name %>
                                            </h6> <small class="text-muted"> <i
                                                    class="bi bi-patch-check-fill text-success me-1"></i> Verified Guest
                                                Review </small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <% }); %>
                </div>
            </div>
            <!-- Slider Controls -->
            <div class="testimonial-controls mt-4"> <button type="button" class="testimonial-arrow" id="testimonialPrev"
                    aria-label="Previous reviews"> <i class="bi bi-arrow-left"></i> </button>
                <div class="testimonial-dots" id="testimonialDots"></div> <button type="button"
                    class="testimonial-arrow" id="testimonialNext" aria-label="Next reviews"> <i
                        class="bi bi-arrow-right"></i> </button>
            </div>
        </div>
    </section>


    <!-- contact  -->

    <section id="contact" class="py-5">
        <div class="container">
            <!-- Heading -->
            <div class="text-center mb-5">
                <span class="contact-subtitle">
                    GET IN TOUCH
                </span>
                <h2 class="fw-bold mt-3">
                    Contact Bhadauriya Enterprises
                </h2>
                <p class="text-muted">
                    Have questions? Reach out to us and we'll reply as soon as possible.
                </p>
            </div>

            <div class="row g-5">
                <!-- Contact Information & Map -->
                <div class="col-lg-6">
                    <div class="contact-info-wrap">
                        <h4 class="fw-bold mb-4" style="color: var(--primary);">Contact Details</h4>

                        <div class="d-flex align-items-start gap-3 mb-4">
                            <div class="contact-icon-box">
                                <i class="bi bi-geo-alt-fill"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1" style="color: var(--primary);">Location</h6>
                                <p class="text-muted mb-0">
                                    <% if (settings && settings.address) { %>
                                        <p>
                                            <%= settings.address %>
                                        </p>
                                        <% } %>
                                </p>
                            </div>
                        </div>

                        <div class="d-flex align-items-start gap-3 mb-4">
                            <div class="contact-icon-box">
                                <i class="bi bi-telephone-fill"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1" style="color: var(--primary);">Phone Number</h6>
                                <p class="text-muted mb-0">
                                    <% if (settings && settings.phone) { %>
                                        <a href="tel:<%= settings.phone %>" style="text-decoration: none; color: black;">
                                            <%= settings.phone %>
                                        </a>
                                        <% } %>
                                </p>

                            </div>
                        </div>

                        <div class="d-flex align-items-start gap-3 mb-4">
                            <div class="contact-icon-box">
                                <i class="bi bi-envelope-fill"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1" style="color: var(--primary);">Email Address</h6>
                                <p class="text-muted mb-0">
                                    <% if (settings && settings.email) { %>
                                        <a href="mailto:<%= settings.email %>" style="text-decoration: none; color: black;">
                                            <%= settings.email %>
                                        </a>
                                        <% } %>
                                </p>
                            </div>
                        </div>

                        <div class="d-flex align-items-start gap-3 mb-4">
                            <div class="contact-icon-box">
                                <i class="bi bi-clock-fill"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1" style="color: var(--primary);">Visiting Hours</h6>
                                <p class="text-muted mb-0">Monday - Saturday: 09:00 AM - 08:00 PM</p>
                            </div>
                        </div>

                        <!-- Map -->
                        <div class="map-container shadow-sm mt-4 rounded-4 overflow-hidden">
                            <iframe
                                src="https://www.google.com/maps/embed?pb=!1m16!1m12!1m3!1d415.0697224765175!2d77.37515870944341!3d28.60611203637839!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!2m1!1sGali%20No.2%2C%20Village%20Mamura%2C%20Sec.-66%2C%20Gautam%20Buddh%20Nagar%20Noida%2C%20U.P-201301!5e0!3m2!1sen!2sin!4v1791543761618!5m2!1sen!2sin"
                                width="100%" height="250" style="border:0;" allowfullscreen="" loading="lazy"
                                referrerpolicy="strict-origin-when-cross-origin"></iframe>
                            <% if (settings && settings.mapLink) { %>
                                <a href="<%= settings.mapLink %>" target="_blank" rel="noopener noreferrer">
                                    View Location
                                </a>
                                <% } %>
                        </div>
                    </div>
                </div>

                <!-- Contact Form -->
                <div class="col-lg-6">
                    <div class="contact-form-card shadow-sm p-4 p-md-5 rounded-4">
                        <h4 class="fw-bold mb-4" style="color: var(--primary);">Send Message</h4>
                        <form action="/submitcontact" method="post">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label for="name" class="form-label fw-semibold">Your Name</label>
                                    <input type="text" class="form-control custom-input" id="name" name="name"
                                        placeholder="Mo Saleem" required>
                                </div>
                                <div class="col-md-6">
                                    <label for="phone" class="form-label fw-semibold">Phone Number</label>
                                    <input type="tel" class="form-control custom-input" id="phone" name="phone"
                                        placeholder="+91 9137497814" required>
                                </div>
                                <div class="col-12">
                                    <label for="email" class="form-label fw-semibold">Email Address</label>
                                    <input type="email" class="form-control custom-input" id="email" name="email"
                                        placeholder="your@email.com" required>
                                </div>
                                <div class="col-12">
                                    <label for="message" class="form-label fw-semibold">Message</label>
                                    <textarea class="form-control custom-input" id="message" name="message" rows="5"
                                        placeholder="Write your message here..." required></textarea>
                                </div>
                                <div class="col-12 mt-4">
                                    <button type="submit" class="btn btn-book py-3 w-100 rounded-pill fw-bold">
                                        Send Message
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </section>


    <% if (bookingSuccess) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Success!</strong> Your booking request has been submitted. We will contact you soon.
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        <% } %>


            <!-- Booking Modal  -->

            <div class="modal fade" id="booking" tabindex="-1">

                <div class="modal-dialog modal-dialog-centered modal-lg">

                    <div class="modal-content booking-modal">

                        <div class="modal-header border-0">

                            <div>

                                <h3 class="fw-bold mb-1">
                                    <i class="bi bi-house-heart-fill text-warning"></i>
                                    Book Your Room
                                </h3>

                                <small class="text-white">
                                    Fill in your details and we'll contact you shortly.
                                </small>

                            </div>

                            <button class="btn-close shadow-none" data-bs-dismiss="modal"></button>

                        </div>

                        <form action="/book-room" method="POST">

                            <div class="modal-body">
                                <div class="row">

                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">
                                            <i class="bi bi-person-fill"></i> Full Name
                                        </label>
                                        <input type="text" name="fullName" class="form-control custom-input"
                                            placeholder="Enter your name" required>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">
                                            <i class="bi bi-envelope-fill"></i> Email
                                        </label>
                                        <input type="email" name="email" class="form-control custom-input"
                                            placeholder="Enter your email" required>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">
                                            <i class="bi bi-telephone-fill"></i> Mobile Number
                                        </label>
                                        <input type="tel" name="mobile" class="form-control custom-input"
                                            placeholder="Enter mobile number" required>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">
                                            <i class="bi bi-calendar-event-fill"></i> Move-in Date
                                        </label>
                                        <input type="date" name="moveInDate" class="form-control custom-input" required>
                                    </div>

                                    <div class="col-md-12 mb-3">
                                        <label class="form-label">
                                            <i class="bi bi-chat-left-text-fill"></i> Message
                                        </label>
                                        <textarea name="message" rows="4" class="form-control custom-input"
                                            placeholder="Write your requirements..."></textarea>
                                    </div>



                                </div>
                            </div>

                            <div class="modal-footer border-0">
                                <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">
                                    Cancel
                                </button>

                                <button type="submit" class="btn booking-btn">
                                    <i class="bi bi-send-fill"></i>
                                    Book Now
                                </button>
                            </div>

                        </form>

                    </div>

                </div>

            </div>

            <%- include('include/footer.ejs') %>