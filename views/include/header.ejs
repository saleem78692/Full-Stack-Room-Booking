<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <meta http-equiv="Pragma" content="no-cache">
    <meta http-equiv="Expires" content="0">
    <title>Room Booking</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/assets/css/style.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css">
</head>

<body>

    <div class="container-fluid p-0">
        <header>
            <!-- Top Header -->
            <div class="container-fluid bg-dark text-white py-2 d-none d-lg-block">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-6">
                            <i class="bi bi-envelope-fill"></i>
                            <% if (settings && settings.email) { %>
                                <a href="mailto:<%= settings.email %>" style="color: white; text-decoration: none;">
                                    <%= settings.email %>
                                </a>
                                <% } %>
                                    &nbsp;&nbsp;|
                                    &nbsp;&nbsp;
                                    <i class="bi bi-telephone-fill"></i>
                                    <% if (settings && settings.phone) { %>
                                        <a href="tel:<%= settings.phone %>"
                                            style="color: white; text-decoration: none;">
                                            <%= settings.phone %>
                                        </a>
                                        <% } %>
                        </div>

                        <div class="col-lg-6 text-end">
                            <% if (settings && settings.facebook) { %>
                                <a href="<%= settings.facebook %>" target="_blank" rel="noopener noreferrer"
                                    aria-label="Facebook" style="text-decoration: none; color: white; margin-right: 10px;">
                                    <i class="bi bi-facebook"></i>
                                </a>
                                <% } %>
                                    <% if (settings && settings.instagram) { %>
                                        <a href="<%= settings.instagram %>" target="_blank" rel="noopener noreferrer"
                                            aria-label="Instagram" style="text-decoration: none; color: white; margin-right: 10px;">
                                            <i class="bi bi-instagram"></i>
                                        </a>
                                        <% } %>
                                            <% if (settings && settings.linkedin) { %>
                                                <a href="<%= settings.linkedin %>" target="_blank"
                                                    rel="noopener noreferrer" aria-label="LinkedIn" style="text-decoration: none; color: white; margin-right: 10px;">
                                                    <i class="bi bi-linkedin"></i>
                                                </a>
                                                <% } %>

                                                    <% if (settings && settings.twitter) { %>
                                                        <a href="<%= settings.twitter %>" target="_blank"
                                                            rel="noopener noreferrer" aria-label="X / Twitter" style="text-decoration: none; color: white; margin-right: 10px;">
                                                            <i class="bi bi-twitter-x"></i>
                                                        </a>
                                                        <% } %>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Navbar -->
            <nav class="navbar navbar-expand-lg custom-navbar" id="navbar">
                <div class="container">

                    <a class="navbar-brand fw-boldtext-primary" href="/">
                        <img src="<%= settings && settings.logo ? (settings.logo.startsWith('http') || settings.logo.startsWith('/') ? settings.logo : '/uploads/' + settings.logo) : '/assets/images/bhadauriyaEnterprises.png' %>"
                            height="70px" alt="Bhadauriya Enterprises" onerror="this.onerror=null;this.src='/assets/images/bhadauriyaEnterprises.png';">
                    </a>

                    <!-- Mobile Button -->
                    <button class="navbar-toggler border-0 shadow-none" data-bs-toggle="offcanvas"
                        data-bs-target="#mobileMenu">

                        <i class="bi bi-list fs-2"></i>

                    </button>

                    <!-- Desktop Menu -->
                    <div class="collapse navbar-collapse justify-content-end d-none d-lg-flex">

                        <ul class="navbar-nav fs-5 align-items-center gap-4">

                            <li class="nav-item">
                                <a class="nav-link active" href="#hero">Home</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="#about">About</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="#service">Services</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="#gallary">Gallery</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="#contact">Contact</a>
                            </li>



                            <!-- <li class="nav-item">
                                <button class="btn-login rounded-pill px-4 py-2">
                                    Login
                                </button>
                            </li> -->

                        </ul>

                    </div>

                </div>
            </nav>

            <!-- Mobile Offcanvas -->
            <div class="offcanvas offcanvas-end" tabindex="-1" id="mobileMenu">

                <div class="offcanvas-header">

                    <a class="navbar-brand fw-bold fs-3 text-primary" href="/">
                        <img src="<%= settings && settings.logo ? (settings.logo.startsWith('http') || settings.logo.startsWith('/') ? settings.logo : '/uploads/' + settings.logo) : '/assets/images/bhadauriyaEnterprises.png' %>"
                            height="60px" alt="Bhadauriya Enterprises" onerror="this.onerror=null;this.src='/assets/images/bhadauriyaEnterprises.png';">
                    </a>

                    <button class="btn-close" data-bs-dismiss="offcanvas">
                    </button>

                </div>

                <div class="offcanvas-body">

                    <ul class="navbar-nav">

                        <li class="nav-item mb-2">
                            <a class="nav-link" href="#hero">Home</a>
                        </li>

                        <li class="nav-item mb-2">
                            <a class="nav-link" href="#about">About</a>
                        </li>

                        <li class="nav-item mb-2">
                            <a class="nav-link" href="#service">Services</a>
                        </li>

                        <li class="nav-item mb-2">
                            <a class="nav-link" href="#gallary">Gallary</a>
                        </li>

                        <li class="nav-item mb-2">
                            <a class="nav-link" href="#contact">Contact</a>
                        </li>

                        

                    </ul>

                </div>

            </div>
        </header>